# Network: "testnet" or "mainnet" (defaults to testnet)
NEXT_PUBLIC_CHAIN=testnet

# Session cookie signing key, at least 32 characters: openssl rand -base64 48
SESSION_SECRET=

# Optional: contract whose `verify` action is signed (not broadcast) at login. Default: xsign (or artcircles on testnet)
AUTH_CONTRACT=

# Optional: domain included in verify_token challenge. Default: circles.artwebin.com
AUTH_DOMAIN=
